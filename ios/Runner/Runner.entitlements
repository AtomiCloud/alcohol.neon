<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(NEON_APP_GROUP)</string>
	</array>
	<!-- TAG only: App Store validation rejects the legacy NDEF value on
	     min-iOS >= 13 builds ("NDEF is disallowed"); TAG covers NDEF reading
	     on modern SDKs. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:t.lazytax.club</string>
	</array>
</dict>
</plist>
