# ─────────────────────────────────────────────────────────────────────────
# Project-specific (alcohol.neon — Flutter mobile). Appended below the
# templated sections above so upstream template pulls stay conflict-free.
# ─────────────────────────────────────────────────────────────────────────

# Flutter / Dart / Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
migrate_working_dir/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Mobile signing material — NEVER commit keystores/certs
*.keystore
*.jks
*.p12
*.pem
*.key
*.dev.vars
.dev.vars
secrets.*
*.secret
